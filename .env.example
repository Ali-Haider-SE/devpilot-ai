# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Comma-separated list of allowed browser origins (empty = no cross-origin access)
CORS_ORIGINS=http://localhost:5173

RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=100

SWAGGER_ENABLED=true

# Used by docker-compose (required, no default on purpose)
POSTGRES_USER=devpilot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=devpilot

# Local (non-docker) run. Inside docker-compose these are overridden to use service names.
DATABASE_URL=postgresql://devpilot:change-me@localhost:5432/devpilot
REDIS_URL=redis://localhost:6379
